{
  "manifest_version": 3,
  "name": "Ayarachi Visual CSS Editor",
  "version": "1.0.0",
  "description": "Personaliza cualquier sitio web visualmente.",
  "author": "Hector Daniel Ayarachi Fuentes",
  "action": {},
  "icons": {
    "16": "icon.svg",
    "128": "icon.svg"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "https://github.com/HectorDanielAyarachiFuentes/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "editor.html",
        "editor/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}