{
  "manifest_version": 3,
  "name": "Ayarachi Visual CSS Editor",
  "version": "7.6.0",
  "description": "Customize any website visually.",
  "author": "Hector Daniel Ayarachi Fuentes",
  "browser_specific_settings": {
    "gecko": {
      "id": "ayarachi-visual-css-editor@ayarachi.dev",
      "strict_min_version": "142.0"
    }
  },
  "action": {
    "default_icon": {
      "16": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "editor.html",
        "editor/*",
        "editor/templates/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}